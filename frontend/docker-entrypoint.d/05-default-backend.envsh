#!/bin/sh

# Default backend URL for runtime when not provided by environment
: "${BACKEND_BASE_URL:=http://localhost:8000}"
export BACKEND_BASE_URL

# Minimal resolver defaults (space-containing defaults avoided for POSIX sh)
: "${NGINX_RESOLVER:=127.0.0.11 1.1.1.1 8.8.8.8 ipv6=off valid=30s}"
export NGINX_RESOLVER

